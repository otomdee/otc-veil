# Copy this file to .env.local and fill in your values.

# Alchemy Starknet RPC key — used by the mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com. The URL prefix is
# already set in constants.ts; paste ONLY the key here.
NEXT_PUBLIC_PROVIDER_URL=your_alchemy_key_here

# OTC settlement helper (cairo/src/otc_settlement.cairo) per network. Leave as
# 0x0 until you deploy; paste the deployed address here afterwards.
NEXT_PUBLIC_OTC_HELPER_MAINNET=0x0
NEXT_PUBLIC_OTC_HELPER_SEPOLIA=0x0

# (Optional) Sepolia test tokens, format: "address:SYMBOL:decimals,..."
# Example with two mock tokens:
# NEXT_PUBLIC_SEPOLIA_TOKENS=0x1234...:TOKEN_A:18,0x5678...:TOKEN_B:6
# NEXT_PUBLIC_SEPOLIA_TOKENS=
